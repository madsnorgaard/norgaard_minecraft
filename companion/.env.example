# Anthropic API key (console.anthropic.com). Empty = dry-run mode (no API calls).
ANTHROPIC_API_KEY=

# Model and reasoning effort (low is fast/cheap and plenty for chat + quests)
KEEPER_MODEL=claude-sonnet-5
KEEPER_EFFORT=low

# Absolute path to the server's latest.log on the host
KEEPER_LOG_PATH=/path/to/minecraft/data/logs/latest.log

# Docker container name of the minecraft server (must have rcon-cli inside)
KEEPER_CONTAINER=minecraft-server

# Chat words that summon the Keeper (comma-separated, case-insensitive)
KEEPER_TRIGGERS=keeper,vogter,vogteren

# Private notes about the players, injected into the persona. Example:
# KEEPER_PLAYER_NOTES=PlayerXyz is Alice, princess of this kingdom - address her royally.
KEEPER_PLAYER_NOTES=

# Where journal.json (the Keeper's memory) lives
KEEPER_STATE_DIR=.

# Cost / spam guards
KEEPER_MAX_CALLS_PER_HOUR=40
KEEPER_MIN_SECONDS_BETWEEN=3
KEEPER_GREET_COOLDOWN_MIN=30
KEEPER_SURPRISE_MIN_HOURS=2
KEEPER_SURPRISE_CHANCE=0.03

# Treat console/rcon `say` lines as chat (useful for testing without a player)
KEEPER_ALLOW_SERVER_CHAT=false
